{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/guard-destructive.sh"
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "grilling": "user-invocable-only",
    "codebase-design": "user-invocable-only",
    "diagnosing-bugs": "user-invocable-only",
    "caveman": "on",
    "code-review": "user-invocable-only",
    "wayfinder": "user-invocable-only",
    "loop-me": "user-invocable-only",
    "handoff": "user-invocable-only"
  },
  "permissions": {
    "allow": [
      "Bash(gh *)",
      "Bash(acli *)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo rename *)",
      "Bash(gh secret set *)",
      "Bash(gh secret delete *)",
      "Bash(gh variable delete *)",
      "Bash(gh release delete *)",
      "Bash(gh gist delete *)",
      "Bash(gh issue delete *)",
      "Bash(gh cache delete *)",
      "Bash(gh run delete *)",
      "Bash(gh ssh-key delete *)",
      "Bash(gh gpg-key delete *)",
      "Bash(gh auth logout *)",
      "Bash(gh project delete *)",
      "Bash(gh label delete *)",
      "Bash(gh workflow disable *)",
      "Bash(acli * delete *)",
      "Bash(acli * deactivate *)",
      "Bash(acli * remove *)"
    ]
  },
}
